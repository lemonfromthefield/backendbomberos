{
  "name": "bomberos-order-management-backend",
  "version": "1.0.0",
  "description": "Backend for fire station purchase order management system",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["bomberos", "purchase-order", "management"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@supabase/supabase-js": "^2.38.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.20",
    "@types/node": "^20.5.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/uuid": "^10.0.0",
    "@types/bcryptjs": "^2.4.2",
    "typescript": "^5.1.6",
    "tsx": "^3.14.0",
    "nodemon": "^3.0.1",
    "eslint": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0"
  }
}
