# ================================
# Configuracion general del backend
# ================================
# Puerto donde corre el servidor Express.
PORT=5000

# Entorno de ejecucion: development | production.
NODE_ENV=development

# ================================
# Configuracion de Supabase
# ================================
# URL del proyecto (Project URL) en Supabase.
SUPABASE_URL=https://xqrcvxsaypuupwtyihwk.supabase.co

# Clave publica (anon key). Se usa en operaciones cliente seguras.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhxcmN2eHNheXB1dXB3dHlpaHdrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4NjUwNDgsImV4cCI6MjA5NDQ0MTA0OH0.h2NjlNcx0imelAmSCpbmwD4nB8v7CbO8lrSz43y9FPo

# Clave service_role. Tiene permisos elevados del backend.
# No compartir ni exponer en frontend.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhxcmN2eHNheXB1dXB3dHlpaHdrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODg2NTA0OCwiZXhwIjoyMDk0NDQxMDQ4fQ.SNxJTNzzZXGaJzehye8aMJzJb5GWmayaN3MYIINXqAg

# ================================
# Configuracion de JWT
# ================================
# Clave secreta para firmar tokens. Usa una larga y aleatoria.
JWT_SECRET=bomberostirolesa123452026!

# Tiempo de expiracion del access token. Ejemplo: 7d, 12h.
JWT_EXPIRY=3h

# ================================
# Admin inicial (bootstrap)
# ================================
# Si esta en true, al iniciar el backend crea un admin general
# solo si la tabla users esta vacia.
BOOTSTRAP_ADMIN_ENABLED=true

# Credenciales del admin inicial.
BOOTSTRAP_ADMIN_EMAIL=comisiondirectivabvct@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=BVCT1902026!
BOOTSTRAP_ADMIN_NAME=Administrador General
BOOTSTRAP_ADMIN_AREA=Comisión Directiva

# ================================
# CORS (origenes permitidos)
# ================================
# Origen principal del frontend.
FRONTEND_URL=http://localhost:5173

# Origenes adicionales separados por coma (opcional).
# Ejemplo para local + Netlify:
# FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,https://tu-sitio.netlify.app

# ================================
# Configuracion de base de datos
# ================================
# URL Postgres directa. En este proyecto es opcional por ahora,
# porque las consultas van por SUPABASE_URL + keys.
DATABASE_URL=your_database_url_here
